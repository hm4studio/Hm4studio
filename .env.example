# ─────────────────────────────────────────────────────────────
# HM4 Studio — sunucu ayarları
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası GİZLİDİR: paylaşmayın, git'e eklemeyin.
# ─────────────────────────────────────────────────────────────

# Sunucunun dinleyeceği port
PORT=3000

# Sitenin yayındaki tam adresi (oturum çerezleri ve bağlantılar için)
SITE_URL=http://localhost:3000

# "production" yapıldığında çerezler yalnızca HTTPS üzerinden gönderilir.
# Yayına alırken mutlaka production yapın ve HTTPS kullanın.
NODE_ENV=development

# Oturum imzalama anahtarı — uzun ve rastgele olmalı.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Veritabanı ve yüklenen dosyaların tutulacağı klasör.
# Sunucuda kalıcı (silinmeyen) bir diske işaret etmeli.
DATA_DIR=./data

# Tek bir yüklemede izin verilen en büyük dosya boyutu (MB)
MAX_UPLOAD_MB=60

# ── Demo modu ──
# true yapıldığında site örnek çiftler ve fotoğraflarla açılır; ziyaretçiler
# "Demo olarak gir" butonlarıyla çift veya stüdyo paneline girip deneyebilir.
# Demo verileri DEMO_RESET_HOURS saatte bir sıfırlanır; görüşler silinmez.
# Gerçek kullanıma geçerken false yapın ve data/ klasörünü temizleyin.
DEMO_MODE=false
DEMO_RESET_HOURS=6

# İsteğe bağlı: sunucu açılırken bu yönetici hesabı yoksa oluşturulur
# (komut satırına erişiminiz yoksa "npm run admin" yerine bunu kullanın).
# Demo modunda görüşleri yalnızca bu gerçek yönetici görebilir.
# Kullanıcı adı boş bırakılırsa "hm4studio" olur. Uygulamada ve sitede aynı giriş
# ekranından (erişim kodu alanına) bu kullanıcı adını yazarak yönetici olarak girersiniz.
ADMIN_USERNAME=hm4studio
# Şifreyi unutursanız: ADMIN_PASSWORD'a yeni şifre yazın, ADMIN_RESET_PASSWORD=1 ekleyin, giriş yapınca bu satırı silin
# ADMIN_RESET_PASSWORD=1
ADMIN_PASSWORD=

# ── İsteğe bağlı: Instagram otomatik akışı ──
# Instagram gönderilerini siteye otomatik çekmek için Instagram Graph API
# erişim anahtarı gerekir (Profesyonel/İşletme hesabı + Meta geliştirici uygulaması).
# Boş bırakılırsa portfolyo yalnızca admin panelinden yüklenen fotoğrafları gösterir.
INSTAGRAM_ACCESS_TOKEN=

# Çift panelindeki yapay zekâ asistanı (boşsa asistan görünmez). Kurulum: deploy/asistan-kur.sh
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── İsteğe bağlı: n8n + WhatsApp otomasyonu ──
# Ayrıntılı kurulum: n8n/BENIOKU.md
# Sitenin n8n'e olay gönderdiği adres (n8n'deki "2 - Site olayları" akışının Webhook adresi)
N8N_WEBHOOK_URL=
# Site ile n8n arasındaki ortak gizli anahtar (uzun, rastgele). n8n'de "HM4 Site" kimlik bilgisine
# "Bearer <anahtar>" olarak girilir. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_API_KEY=
# Meta WhatsApp Business: Telefon numarası kimliği (Phone number ID) — gizli değildir
WHATSAPP_PHONE_NUMBER_ID=
# Meta'nın webhook doğrulamasında kullanılacak, sizin belirlediğiniz bir kelime/kod
WHATSAPP_VERIFY_TOKEN=
# Meta Graph API sürümü (Meta eski sürümleri zamanla kapatır; gerekirse güncelleyin)
WHATSAPP_API_VERSION=v23.0
