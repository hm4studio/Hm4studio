      "notes": "Kimlik bilgisi: HM4 Site (Header Auth)",
      "credentials": {
        "httpHeaderAuth": {
          "id": "hm4SiteKey000001",
          "name": "HM4 Site"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Her hatırlatma ayrı bir WhatsApp mesajı olur\nconst siteUrl = $('Ayarlar').first().json.siteUrl;\nconst items = $input.first().json.items || [];\nreturn items.map((it) => ({ json: { url: it.whatsapp.url, body: it.whatsapp.body, keys: it.keys, type: it.type, couple: it.couple, siteUrl } }));"
      },
      "id": "32d86a5c-dbd8-4877-8ffa-d6f28a5a0feb",
      "name": "Hatırlatmaları ayır",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}"
      },
      "id": "ac88e79e-d9c0-4597-b7ed-37ee6d523206",
      "name": "WhatsApp'a gönder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "notes": "Kimlik bilgisi: WhatsApp Cloud API (Header Auth)",
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "hm4WhatsApp00001",
          "name": "WhatsApp Cloud API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Yalnızca başarıyla gönderilenler 'gönderildi' olarak işaretlenir; hatalı olanlar ertesi gün yeniden denenir\nconst src = $('Hatırlatmaları ayır').all();\nconst keys = [];\n$input.all().forEach((it, i) => {\n  if (it.json && Array.isArray(it.json.messages)) keys.push(...(src[i]?.json.keys || []));\n});\nreturn [{ json: { keys, siteUrl: $('Ayarlar').first().json.siteUrl } }];"
      },
      "id": "5e02a163-ed0f-40e7-ac35-d73f9ce0fba9",
      "name": "Gönderilenleri topla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
