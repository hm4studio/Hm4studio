    {
      "parameters": {
        "jsCode": "// Site, gönderilecek WhatsApp mesajını 'whatsapp' alanında hazır gönderir.\n// Mesajı olmayan olaylar (ör. plan kaydedildi) burada durur; isterseniz yanlarına e-posta vb. ekleyebilirsiniz.\nreturn $input.all()\n  .map((i) => i.json.body || {})\n  .filter((b) => b.whatsapp && b.whatsapp.url && b.whatsapp.body)\n  .map((b) => ({ json: { url: b.whatsapp.url, body: b.whatsapp.body, event: b.event } }));"
      },
      "id": "9a3f3e10-c36d-4589-8313-c2ff622eb710",
      "name": "Mesaj var mı?",
